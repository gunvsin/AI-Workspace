generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  googleId      String    @unique
  email         String    @unique
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  profile       Profile?
  notes         Note[]
  configs       UserConfig[]
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  role        String?
  company     String?
  industry    String?
  goals       String[]
  preferences Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  content   String
  tags      String[]
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])

  // Backlinks (Obsidian-style internal links)
  linksFrom NoteRelation[] @relation("from")
  linksTo   NoteRelation[] @relation("to")
}

model NoteRelation {
  id         String @id @default(cuid())
  fromNoteId String
  toNoteId   String
  fromNote   Note   @relation("from", fields: [fromNoteId], references: [id])
  toNote     Note   @relation("to", fields: [toNoteId], references: [id])
  type       String @default("links")

  @@unique([fromNoteId, toNoteId, type])
  @@index([toNoteId])
}

model UserConfig {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}
